<Window x:Class="DeskDuck.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to use DeskDuck" Height="600" Width="520"
        MinHeight="400" MinWidth="380"
        Icon="../Assets/Icons/DeskDuck Logo (Transparent).png"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="Transparent">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="How DeskDuck works" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="DeskDuck keeps your music at full volume until one of your chosen apps actually starts making sound. Then it dips the music, holds it down while that app is going, and brings it back when things go quiet."/>

            <TextBlock Text="SETUP IN 30 SECONDS" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="1. WHAT TO DUCK: pick your music app (usually Spotify)."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="2. WHEN TO DUCK: tick the apps that should dip your music, like your music software, game engine, or browser."/>
            <TextBlock TextWrapping="Wrap" Text="3. Flip the Enabled switch on. Done."/>

            <TextBlock Text="TRIGGER MODES" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="Session activity dips the music whenever a ticked app's sound engine is running, even if what it plays is barely audible. Pick this for quiet background work that should always win."/>
            <TextBlock TextWrapping="Wrap" Text="Audio level dips only while a ticked app is louder than your threshold. Set the threshold with the slider and watch the Level column in the Sessions window to find the right spot. The dip lets go a few decibels below the threshold so it never flickers."/>

            <TextBlock Text="KNOBS" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="Duck to: how far the music dips. 1% is close to silent, 100% means no dip at all."/>
            <TextBlock TextWrapping="Wrap" Text="Attack: how fast the music dips. Hold: how long DeskDuck waits after things go quiet before bringing the music back. Release: how fast the music comes back."/>

            <TextBlock Text="STATUS" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="NORMAL means the music is untouched. DUCKED means a trigger is going and the music is dipped. HOLDING and RELEASING mean the triggers went quiet and the music is on its way back. DISABLED means the master switch is off and DeskDuck will not touch anything."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="Test Duck runs one dip-and-restore on demand, so you can check your volumes without starting a trigger app."/>
            <TextBlock TextWrapping="Wrap" Text="The Sessions and Log buttons open live behind-the-scenes views. Sessions shows every app making sound and highlights the one causing the dip. Log records what DeskDuck did and when."/>

            <TextBlock Text="WORDS WORTH KNOWING" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="dB (decibel) is a loudness scale. 0 is the loudest, −60 is silence. A higher threshold such as −10 means only loud sounds count. A lower one such as −50 means almost anything counts."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="ACTIVE means the app is currently sending sound to Windows, even very quiet sound. Just having the app open does not count."/>
            <TextBlock TextWrapping="Wrap" Text="To duck means to turn the music down briefly, then bring it back. Think of a DJ dipping the music to talk over it."/>
        </StackPanel>
    </ScrollViewer>
</Window>
