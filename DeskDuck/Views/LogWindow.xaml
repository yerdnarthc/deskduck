<Window x:Class="DeskDuck.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log" Height="320" Width="540"
        MinHeight="220" MinWidth="400"
        Icon="../Assets/Icons/DeskDuck Logo (Transparent).png"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Clear" Click="Clear_Click"/>
        </StackPanel>
        <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11"/>
    </DockPanel>
</Window>
