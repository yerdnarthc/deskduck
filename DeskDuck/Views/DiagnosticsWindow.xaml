<Window x:Class="DeskDuck.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio sessions" Height="340" Width="520"
        MinHeight="240" MinWidth="400"
        Icon="../Assets/Icons/DeskDuck Logo (Transparent).png"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Text="Live Windows audio sessions. Orange rows are currently ducking the target."/>
        <ListView ItemsSource="{Binding Sessions}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCausingDuck}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Application" Width="140" DisplayMemberBinding="{Binding ProcessName}"/>
                    <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding ProcessId}"/>
                    <GridViewColumn Header="State" Width="70" DisplayMemberBinding="{Binding State}"/>
                    <GridViewColumn Header="Level" Width="65" DisplayMemberBinding="{Binding LevelText}"/>
                    <GridViewColumn Header="Role" Width="75" DisplayMemberBinding="{Binding Role}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
