<Window x:Class="DeskDuck.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio sessions" Height="340" Width="650"
        MinHeight="240" MinWidth="400"
        Icon="../Assets/Icons/DeskDuck Logo (Transparent).png"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Text="Live Windows audio sessions. Orange rows are currently ducking the target."/>
        <ListView ItemsSource="{Binding Sessions}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <!-- GridView rows MUST host a GridViewRowPresenter (not a plain
                     ContentPresenter) or columns collapse into ToString(). -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Row" Background="Transparent" Padding="4,2">
                                    <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                          Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCausingDuck}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="16" Height="16">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Application" Width="200" DisplayMemberBinding="{Binding ProcessName}"/>
                    <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding ProcessId}"/>
                    <GridViewColumn Header="State" Width="100" DisplayMemberBinding="{Binding State}"/>
                    <GridViewColumn Header="Level" Width="65" DisplayMemberBinding="{Binding LevelText}"/>
                    <GridViewColumn Header="Role" Width="75" DisplayMemberBinding="{Binding Role}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
