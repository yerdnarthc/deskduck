<Window x:Class="DeskDuck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DeskDuck.Controls"
        mc:Ignorable="d"
        Title="DeskDuck" Height="640" Width="440"
        MinHeight="520" MinWidth="380">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="DeskDuck" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding DeviceName, StringFormat='Output: {0}'}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

            <!-- Status hero: what the app is doing right now, at a glance. -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CreamBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="DUCKED">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="DUCKING">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="HOLDING">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="RELEASING">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="DISABLED">
                                            <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" Margin="0,2,0,0}"/>
                    <TextBlock Text="{Binding TargetVolumeText}" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Test Duck" Command="{Binding TestDuckCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <GroupBox Header="What to duck">
                <StackPanel>
                    <Label Target="{Binding ElementName=TargetBox}" Content="Music app"/>
                    <ComboBox x:Name="TargetBox" IsEditable="True"
                              ItemsSource="{Binding AvailableApps}" DisplayMemberPath="Label"
                              Text="{Binding TargetProcessName, UpdateSourceTrigger=LostFocus}"
                              DropDownClosed="TargetBox_DropDownClosed"
                              ToolTip="Process name of the music app, e.g. Spotify"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="When to duck">
                <StackPanel>
                    <ListBox ItemsSource="{Binding TriggerOptions}" MaxHeight="110" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <RadioButton Content="Session activity (any loudness)"
                                 IsChecked="{Binding IsActivityMode}" Margin="0,6,0,2"
                                 ToolTip="Duck while a trigger's audio session is ACTIVE"/>
                    <RadioButton Content="Audio level (louder than…)"
                                 IsChecked="{Binding IsLevelMode}" Margin="0,2"
                                 ToolTip="Duck while a trigger's peak level is above the threshold"/>
                    <StackPanel Visibility="{Binding IsLevelMode, Converter={StaticResource BoolToVis}}">
                        <Label Target="{Binding ElementName=ThresholdSlider}" Content="{Binding ThresholdText, StringFormat='Threshold: {0}'}"/>
                        <Slider x:Name="ThresholdSlider" Minimum="-60" Maximum="0" TickFrequency="3" IsSnapToTickEnabled="True"
                                Value="{Binding ThresholdDb, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Peak level that engages ducking; releases 3 dB below this"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="How loud">
                <StackPanel>
                    <Label Target="{Binding ElementName=DuckSlider}" Content="{Binding DuckFactorText, StringFormat='Duck to {0} of normal volume'}"/>
                    <Slider x:Name="DuckSlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding DuckFactorPercent, UpdateSourceTrigger=PropertyChanged}"/>
                    <UniformGrid Columns="3" Margin="0,8,0,0" Rows="1">
                        <controls:Knob Caption="Attack" Unit="ms" Minimum="0" Maximum="5000"
                                       Step="5" DefaultValue="100"
                                       Value="{Binding AttackMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTip="Fade time into ducking. Drag, scroll, or use arrow keys; double-click resets to 100 ms."/>
                        <controls:Knob Caption="Hold" Unit="ms" Minimum="0" Maximum="10000"
                                       Step="10" DefaultValue="400"
                                       Value="{Binding HoldMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTip="Wait after triggers go quiet before releasing. Double-click resets to 400 ms."/>
                        <controls:Knob Caption="Release" Unit="ms" Minimum="0" Maximum="10000"
                                       Step="10" DefaultValue="800"
                                       Value="{Binding ReleaseMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTip="Fade time back to normal volume. Double-click resets to 800 ms."/>
                    </UniformGrid>
                    <TextBlock Text="Tip: hold Shift while dragging a knob for fine control."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{Binding SessionsCount, StringFormat='_Sessions ({0})'}"
                        Click="SessionsButton_Click" Margin="0,0,8,0"
                        ToolTip="Open the live audio-session monitor (Alt+S)"/>
                <Button Content="{Binding LogCount, StringFormat='_Log ({0})'}"
                        Click="LogButton_Click"
                        ToolTip="Open the event log (Alt+L)"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
